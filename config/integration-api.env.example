# Accessible OCR 통합 서버용 환경변수 예시
#
# 사용 방법:
# 1. 이 파일을 같은 폴더의 integration-api.env로 복사한다.
# 2. REPLACE_WITH_... 값을 실제 발급값으로 교체한다.
# 3. integration-api.env는 Git에서 제외되므로 절대 강제로 커밋하지 않는다.
#
# 주의: 이 값들은 Windows EXE의 appsettings 파일에 넣지 않는다.

CLOVA_OCR_INVOKE_URL=REPLACE_WITH_REAL_CLOVA_OCR_INVOKE_URL
CLOVA_OCR_SECRET=REPLACE_WITH_REAL_CLOVA_OCR_SECRET

# WPF 앱과 같은 PC에서 실행되는 로컬 OCR API 설정
OCR_API_HOST=127.0.0.1
OCR_API_PORT=8000
OCR_DPI=200
OCR_LAYOUT_MODEL=doclaynet

# 팀 ai_engine: scripts/setup-chart.ps1 실행 후 활성화. 기본 모델은 최초 다운로드 필요.
CHART_RECOGNITION_ENABLED=false
CHART_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
CHART_TIMEOUT=900
CHART_MAX_PIXELS=401408

# 모델팀의 Audiveris 기반 악보 인식기. Windows 설치 경로에 맞게 수정한다.
# 예: C:\Program Files\Audiveris\bin\Audiveris.bat
MUSIC_RECOGNITION_ENABLED=true
MUSIC_MODEL_ROOT=daisy-music
AUDIVERIS_CMD=REPLACE_WITH_REAL_AUDIVERIS_EXECUTABLE_PATH
AUDIVERIS_TIMEOUT=600
# rules: Ollama 없이 악보 구조에 근거한 규칙 요약. auto: 기존 Ollama 시도/실패 시 규칙 요약.
MUSIC_SUMMARY_MODE=rules

# 모델팀 API가 확정되면 아래 두 값도 교체한다.
MODEL_API_URL=REPLACE_WITH_REAL_MODEL_API_URL
MODEL_API_KEY=REPLACE_WITH_REAL_MODEL_API_KEY

# 통합 서버의 개발용 저장소 설정. 서버 구현 시 형식을 확정한다.
DATABASE_CONNECTION_STRING=REPLACE_WITH_REAL_DATABASE_CONNECTION_STRING
FILE_STORAGE_CONNECTION_STRING=REPLACE_WITH_REAL_FILE_STORAGE_CONNECTION_STRING
