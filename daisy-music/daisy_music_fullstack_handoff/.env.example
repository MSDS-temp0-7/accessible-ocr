# ============================================================
# OCR-DAISY 악보 API 환경변수 예시
# 실제 서버 환경에 맞게 값을 변경합니다.
# ============================================================

# ------------------------------------------------------------
# 1. Audiveris
# ------------------------------------------------------------
# [필수]
# Music API가 실행되는 서버의 실제 Audiveris 실행 파일 경로입니다.
#
# macOS 예시:
# AUDIVERIS_CMD=/Applications/Audiveris.app/Contents/MacOS/Audiveris
#
# Linux 예시:
# AUDIVERIS_CMD=/opt/audiveris/bin/Audiveris
#
# Windows 예시:
# AUDIVERIS_CMD=C:\\Program Files\\Audiveris\\Audiveris.exe

AUDIVERIS_CMD=/path/to/audiveris

# 악보 한 장당 Audiveris 최대 처리 시간(초)
AUDIVERIS_TIMEOUT=600

# ------------------------------------------------------------
# 2. 기존 Ollama / Local LLM 서버
# ------------------------------------------------------------
# [필수 확인]
# 풀스택 환경에 이미 Ollama가 있으면 해당 주소를 입력합니다.
# 프론트 브라우저에서 Ollama를 직접 호출하지 않습니다.

OLLAMA_BASE_URL=http://127.0.0.1:11434

# 현재 프로젝트에서 사용 중인 모델
OLLAMA_MODEL=qwen3:8b

# Grounded summarizer timeout
LOCAL_LLM_TIMEOUT=180

# ------------------------------------------------------------
# 3. API 파일 저장 경로
# ------------------------------------------------------------

# 사용자가 업로드한 원본 이미지 임시 저장 위치
MUSIC_UPLOAD_ROOT=./api_uploads

# Audiveris + Music Pipeline 요청별 결과 저장 위치
MUSIC_RECOGNITION_ROOT=./music_api_runs

# 최대 업로드 파일 크기(byte)
# 아래 값 = 50 MiB
MAX_MUSIC_UPLOAD_BYTES=52428800

# ------------------------------------------------------------
# 4. CORS
# ------------------------------------------------------------
# 브라우저에서 Music API 호출을 허용할 프론트 주소입니다.
# 운영 배포 전 실제 프론트 URL로 변경해야 합니다.

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------
# 5. 풀스택팀 체크
# ------------------------------------------------------------
# [필수] AUDIVERIS_CMD 실제 경로
# [필수] OLLAMA_BASE_URL 실제 서버 주소
# [확인] qwen3:8b 모델 존재 여부
# [필수] CORS_ORIGINS 실제 프론트 주소
# [선택] 저장 경로 / 업로드 제한 / timeout 정책
