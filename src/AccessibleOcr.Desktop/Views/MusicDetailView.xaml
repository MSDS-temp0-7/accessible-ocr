<UserControl x:Class="AccessibleOcr.Desktop.Views.MusicDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="악보 상세" FontSize="28" FontWeight="Bold" Foreground="#18344A" />
        <Border Grid.Row="1" Background="#EAF2FA" BorderBrush="#2C75B9" BorderThickness="1" Padding="16" CornerRadius="5" Margin="0,18,0,20">
            <StackPanel><TextBlock Text="악보 1 · 연습곡 A" FontSize="20" FontWeight="SemiBold" Foreground="#18344A" /><TextBlock Text="피아노 · 4/4박자 · 다장조 · 16마디 · 오른손/왼손 2성부" Margin="0,7,0,0" Foreground="#34536B" /></StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#D7E0E8" BorderThickness="1" Padding="28" CornerRadius="5,0,0,5">
                <StackPanel>
                    <TextBlock Text="마디 탐색" FontSize="18" FontWeight="SemiBold" Foreground="#18344A" />
                    <ItemsControl ItemsSource="{Binding Measures}" Margin="0,20,0,0" automation:AutomationProperties.Name="악보 마디 목록">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#B8C6D4" BorderThickness="1" Padding="20,14" Margin="0,0,16,16" Width="130" CornerRadius="4"><TextBlock Text="{Binding}" TextAlignment="Center" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="현재: 3마디, 오른손, 4분음표 미-솔-도" FontWeight="SemiBold" Foreground="#18344A" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" BorderBrush="#D7E0E8" BorderThickness="0,1,1,1" Padding="28" CornerRadius="0,5,5,0">
                <StackPanel>
                    <TextBlock Text="접근형 표현" FontSize="18" FontWeight="SemiBold" Foreground="#18344A" />
                    <TextBlock Text="요약" Foreground="#607385" Margin="0,20,0,6" />
                    <TextBlock Text="상행하는 분산화음 패턴" FontSize="18" FontWeight="SemiBold" Foreground="#18344A" />
                    <TextBlock Text="세부 읽기" Foreground="#607385" Margin="0,26,0,6" />
                    <TextBlock Text="오른손: 4분음표 미, 솔, 높은 도\n왼손: 온음표 도" TextWrapping="Wrap" Foreground="#34536B" />
                    <TextBlock Text="내보내기" Foreground="#607385" Margin="0,26,0,6" />
                    <TextBlock Text="MusicXML · 점자악보(후속 검증)" TextWrapping="Wrap" Foreground="#34536B" />
                </StackPanel>
            </Border>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,20,0,0">
            <Border Background="#FFF8E8" BorderBrush="#E6A12C" BorderThickness="1" Padding="16" CornerRadius="5" DockPanel.Dock="Left">
                <StackPanel><TextBlock Text="전문 검수 필요" FontWeight="SemiBold" Foreground="#9A5A00" /><TextBlock Text="악보 자동 변환은 원본·구조·사람 검수 이력을 함께 보존합니다." Margin="0,5,0,0" Foreground="#7A5521" /></StackPanel>
            </Border>
            <Button Content="전문 검수 요청" Width="145" Margin="18,0,0,8" />
        </DockPanel>
    </Grid>
</UserControl>
