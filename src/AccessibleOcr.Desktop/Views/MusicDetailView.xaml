<UserControl x:Class="AccessibleOcr.Desktop.Views.MusicDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="악보 상세" FontSize="28" FontWeight="Bold" Foreground="#18344A" />
        <Border Grid.Row="1" Background="White" BorderBrush="#D7E0E8" BorderThickness="1"
                Padding="30" CornerRadius="6" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="실제 OCR 결과" FontSize="18" FontWeight="SemiBold" Foreground="#18344A" />
                <TextBlock Text="{Binding SelectedBlock.Id}" Foreground="#607385" Margin="0,8,0,18" />
                <TextBox Text="{Binding SelectedBlock.Content}" IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" MinHeight="180" Background="#F7F9FB"
                         automation:AutomationProperties.Name="선택한 악보 OCR 내용" />
                <TextBlock Margin="0,18,0,0" Foreground="#52697A">
                    <Run Text="페이지 " /><Run Text="{Binding SelectedBlock.PageNumber, Mode=OneWay}" />
                    <Run Text=" · 신뢰도 " /><Run Text="{Binding SelectedBlock.Confidence, Mode=OneWay, StringFormat={}{0:P0}}" />
                    <Run Text=" · 상태 " /><Run Text="{Binding SelectedBlock.ReviewStatus, Mode=OneWay}" />
                </TextBlock>
                <Border Background="#FFF8E8" BorderBrush="#E6A12C" BorderThickness="1" Padding="16" Margin="0,24,0,0">
                    <TextBlock Text="이 내용은 Audiveris 기반 악보 인식과 MusicXML 분석 결과입니다. 신뢰도가 낮거나 빈 마디가 있는 결과는 반드시 원본 악보와 대조해 검수하세요. 점자악보 변환과 DAISY 최종 패키징은 별도 단계입니다."
                               TextWrapping="Wrap" Foreground="#7A5521" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
