<UserControl x:Class="AccessibleOcr.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid Background="#F4F7FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <Border Background="#123A59">
            <StackPanel Margin="70" VerticalAlignment="Center" MaxWidth="540">
                <TextBlock Foreground="White" FontSize="38" FontWeight="Bold" Text="접근형 OCR" />
                <TextBlock Margin="0,18,0,0" Foreground="#D7E8F5" FontSize="19" LineHeight="30" TextWrapping="Wrap"
                           Text="문서를 구조화하고 검수하여 누구나 읽을 수 있는 결과물로 만드는 Windows 작업공간입니다." />
                <Border Margin="0,34,0,0" Padding="18" Background="#173F5E" BorderBrush="#507590" BorderThickness="1" CornerRadius="7">
                    <TextBlock Foreground="#D7E8F5" TextWrapping="Wrap"
                               Text="계정과 역할은 통합 서버에서 확인합니다. 비밀번호와 토큰은 앱 설정 파일에 저장하지 않습니다." />
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Background="White">
            <StackPanel Width="390" VerticalAlignment="Center">
                <TextBlock FontSize="30" FontWeight="Bold" Foreground="#18344A" Text="로그인" />
                <TextBlock Margin="0,8,0,30" Foreground="#607385" Text="접근형 OCR 계정 정보를 입력하세요." />

                <TextBlock FontWeight="SemiBold" Foreground="#18344A" Text="이메일" />
                <TextBox Margin="0,8,0,18" Height="42" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         automation:AutomationProperties.Name="로그인 이메일" />

                <TextBlock FontWeight="SemiBold" Foreground="#18344A" Text="비밀번호" />
                <PasswordBox Margin="0,8,0,22" Height="42" Padding="10,7" PasswordChanged="PasswordBox_OnPasswordChanged"
                             automation:AutomationProperties.Name="로그인 비밀번호" />

                <Button Height="44" Command="{Binding LoginCommand}" Content="로그인" IsDefault="True"
                        automation:AutomationProperties.Name="통합 서버에 로그인" />

                <Button Height="42" Margin="0,4,0,0" Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenSignUpCommand}" Content="회원가입"
                        automation:AutomationProperties.Name="회원가입 화면 열기" />

                <Border Margin="0,15,0,0" Padding="13" Background="#F4F7FA" CornerRadius="5">
                    <TextBlock Foreground="#52697A" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               automation:AutomationProperties.LiveSetting="Polite" />
                </Border>

                <StackPanel Margin="0,26,0,0" Visibility="{Binding DevelopmentPreviewVisibility}">
                    <Separator Margin="0,0,0,18" />
                    <TextBlock Foreground="#8A5B00" TextWrapping="Wrap"
                               Text="Debug 빌드 전용: 인증 서버 연결 전 UI 확인에만 사용합니다. 실제 로그인이나 권한 검증이 아닙니다." />
                    <Button Margin="0,12,0,0" Style="{StaticResource SecondaryButton}" Command="{Binding DevelopmentPreviewCommand}"
                            Content="개발 미리보기로 열기" automation:AutomationProperties.Name="인증 없이 개발 UI 미리보기" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
