<UserControl x:Class="AccessibleOcr.Desktop.Views.ReviewWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,4,0,18">
            <StackPanel>
                <TextBlock Text="검토 워크스페이스" FontSize="28" FontWeight="Bold" Foreground="#18344A" />
                <TextBlock Text="{Binding DocumentTitle}" Foreground="#52697A" Margin="0,7,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="검수·내보내기" Width="125" Margin="0"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="Export"
                    automation:AutomationProperties.Name="검수 완료와 내보내기 화면 열기" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" Padding="16" BorderBrush="#D7E0E8" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6">
                <StackPanel>
                    <TextBlock Text="페이지" FontWeight="SemiBold" Foreground="#18344A" />
                    <ListBox ItemsSource="{Binding PageNumbers}" SelectedItem="{Binding SelectedPageNumber}" Margin="0,12,0,24"
                             automation:AutomationProperties.Name="문서 페이지 목록" />
                    <TextBlock Text="객체 목록" FontWeight="SemiBold" Foreground="#18344A" />
                    <ListBox ItemsSource="{Binding Blocks}" SelectedItem="{Binding SelectedBlock}" Margin="0,12,0,0"
                             automation:AutomationProperties.Name="특수 객체 목록">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Type}" Foreground="#607385" FontSize="12" />
                                    <TextBlock Text="{Binding Confidence, StringFormat={}{0:P0}}" Foreground="#607385" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#EAF0F5" BorderBrush="#D7E0E8" BorderThickness="0,1,0,1" Padding="26">
                <Grid>
                    <Border Background="White" Width="510" Height="620" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#B9C7D3" BorderThickness="1" Padding="38">
                        <StackPanel>
                            <TextBlock Text="문단 흐름 / 원본 페이지 미리보기" FontWeight="SemiBold" Foreground="#607385" HorizontalAlignment="Center" />
                            <Rectangle Height="22" Fill="#DCE8F1" Margin="0,38,0,13" />
                            <Rectangle Height="12" Fill="#E8EEF3" Margin="0,0,0,9" />
                            <Rectangle Height="12" Fill="#E8EEF3" Margin="0,0,0,9" />
                            <Border BorderBrush="#E6A12C" BorderThickness="3" Height="76" Margin="0,27,0,27" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="수식 3 · 인라인 · 신뢰도 76% · 설명 검토 필요" Foreground="#9A5A00" FontWeight="SemiBold" />
                                    <TextBlock Text="F = m × a" Foreground="#18344A" FontSize="21" FontWeight="Bold" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Rectangle Height="115" Fill="#E8EEF3" Margin="0,0,0,9" />
                            <TextBlock Text="실제 연동 단계에서 원본 이미지와 정규화된 OCR 좌표가 이 영역에 표시됩니다." TextWrapping="Wrap" Foreground="#607385" FontSize="12" Margin="0,22,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" Padding="18" BorderBrush="#D7E0E8" BorderThickness="0,1,1,1" CornerRadius="0,6,6,0">
                <StackPanel>
                    <TextBlock Text="객체 검사" FontSize="18" FontWeight="SemiBold" Foreground="#18344A" />
                    <TextBlock Text="{Binding SaveStatus}" TextWrapping="Wrap" Foreground="#607385" Margin="0,7,0,18"
                               automation:AutomationProperties.Name="블록 편집 상태" automation:AutomationProperties.LiveSetting="Polite" />

                    <TextBlock Text="인식 결과" FontWeight="SemiBold" />
                    <TextBox Height="150" Margin="0,8,0,14" TextWrapping="Wrap" AcceptsReturn="True"
                             Text="{Binding SelectedBlock.Content, UpdateSourceTrigger=PropertyChanged}"
                             automation:AutomationProperties.Name="선택한 OCR 블록 내용" />

                    <TextBlock Text="검수 상태" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedBlock.ReviewStatus}" Margin="0,8,0,20" Foreground="#34536B" />
                    <Button Content="상세 열기" Style="{StaticResource SecondaryButton}" Command="{Binding OpenDetailCommand}"
                            automation:AutomationProperties.Name="선택한 특수 객체 상세 열기" />
                    <Button Content="수정 저장" Command="{Binding SaveCommand}" automation:AutomationProperties.Name="OCR 블록 수정 내용 저장" />
                    <Button Content="검토 완료로 표시" Style="{StaticResource SecondaryButton}" Command="{Binding MarkReviewedCommand}"
                            automation:AutomationProperties.Name="선택한 OCR 블록 검토 완료" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
