<UserControl x:Class="AccessibleOcr.Desktop.Views.MathDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TextBlock Text="수식 상세" FontSize="28" FontWeight="Bold" Foreground="#18344A" />
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Border Background="White" BorderBrush="#D7E0E8" BorderThickness="1" Padding="28" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="원본 이미지" FontWeight="SemiBold" Foreground="#607385" />
                        <Border Background="#F4F7FA" BorderBrush="#C7D3DF" BorderThickness="1" Padding="38" Margin="0,18,0,0">
                            <TextBlock Text="F = m × a" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#182C3D" />
                        </Border>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#D7E0E8" BorderThickness="1" Padding="28" CornerRadius="5" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="기호 탐색" FontSize="18" FontWeight="SemiBold" Foreground="#18344A" />
                        <ItemsControl ItemsSource="{Binding Symbols}" Margin="0,16,0,0" automation:AutomationProperties.Name="수식 기호 목록">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#B8C6D4" BorderThickness="1" Padding="16,12" Margin="0,0,10,10" CornerRadius="4"><TextBlock Text="{Binding}" TextAlignment="Center" FontWeight="SemiBold" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Border Background="White" BorderBrush="#D7E0E8" BorderThickness="1" Padding="28" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="읽기 표현" FontSize="18" FontWeight="SemiBold" Foreground="#18344A" />
                        <TextBlock Text="선형" Foreground="#607385" Margin="0,18,0,6" />
                        <TextBox Text="F equals m times a" automation:AutomationProperties.Name="수식 선형 표현" />
                        <TextBlock Text="자연어" Foreground="#607385" Margin="0,18,0,6" />
                        <TextBlock Text="힘은 질량 곱하기 가속도" FontSize="18" FontWeight="SemiBold" Foreground="#18344A" />
                    </StackPanel>
                </Border>
                <Border Background="#FFF8E8" BorderBrush="#E6A12C" BorderThickness="1" Padding="28" CornerRadius="5" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="검수 상태" FontSize="18" FontWeight="SemiBold" Foreground="#9A5A00" />
                        <TextBlock Text="신뢰도 76%\n기호 1개 확인 필요" FontSize="24" FontWeight="Bold" Margin="0,18,0,20" Foreground="#7A5521" />
                        <StackPanel Orientation="Horizontal"><Button Content="다시 인식" Style="{StaticResource SecondaryButton}" Width="110" /><Button Content="검수 완료" Width="110" Margin="10,0,0,8" /></StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

