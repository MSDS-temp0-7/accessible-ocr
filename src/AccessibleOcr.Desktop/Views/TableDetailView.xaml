<UserControl x:Class="AccessibleOcr.Desktop.Views.TableDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="표·도표 상세" FontSize="28" FontWeight="Bold" Foreground="#18344A" />
        <Border Grid.Row="1" Background="White" BorderBrush="#D7E0E8" BorderThickness="1"
                Padding="30" CornerRadius="6" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="실제 OCR 결과" FontSize="18" FontWeight="SemiBold" Foreground="#18344A" />
                <TextBlock Text="{Binding SelectedBlock.Id}" Foreground="#607385" Margin="0,8,0,18" />
                <TextBox Text="{Binding SelectedBlock.Content}" IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" MinHeight="180" Background="#F7F9FB"
                         automation:AutomationProperties.Name="선택한 표 또는 도표 OCR 내용" />
                <TextBlock Margin="0,18,0,0" Foreground="#52697A">
                    <Run Text="유형 " /><Run Text="{Binding SelectedBlock.Type}" />
                    <Run Text=" · 페이지 " /><Run Text="{Binding SelectedBlock.PageNumber}" />
                    <Run Text=" · 신뢰도 " /><Run Text="{Binding SelectedBlock.Confidence, StringFormat={}{0:P0}}" />
                    <Run Text=" · 상태 " /><Run Text="{Binding SelectedBlock.ReviewStatus}" />
                </TextBlock>
                <Border Background="#FFF8E8" BorderBrush="#E6A12C" BorderThickness="1" Padding="16" Margin="0,24,0,0">
                    <TextBlock Text="영역은 실제로 검출됐지만 표 셀·행·열 구조 또는 그래프 설명 전용 모델은 아직 연결되지 않았습니다. 가짜 셀 데이터는 표시하지 않습니다."
                               TextWrapping="Wrap" Foreground="#7A5521" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
