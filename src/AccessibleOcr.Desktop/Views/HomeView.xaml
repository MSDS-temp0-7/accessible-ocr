<UserControl x:Class="AccessibleOcr.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,4,0,22">
            <TextBlock Text="문서를 가져와 접근 가능한 구조로 변환" FontSize="28" FontWeight="Bold" Foreground="#18344A" />
            <TextBlock Text="PDF와 스캔 이미지를 업로드하면 OCR 초안과 검수 작업 공간을 준비합니다." Margin="0,9,0,0" Foreground="#52697A" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="34" BorderBrush="#D7E0E8" BorderThickness="1" MinHeight="360">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="프로젝트 이름" FontWeight="SemiBold" Foreground="#18344A" />
                    <TextBox Margin="0,8,0,0" Width="420" Text="{Binding ProjectTitle, UpdateSourceTrigger=PropertyChanged}"
                             automation:AutomationProperties.Name="프로젝트 이름" />
                </StackPanel>

                <Border Grid.Row="1" Grid.Column="0" Margin="0,28,20,24" Background="#F8FBFD" BorderBrush="#8DAAC1" BorderThickness="1" CornerRadius="5">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="파일을 여기에 놓거나 선택하세요" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#18344A" />
                        <TextBlock Text="현재 OCR 파이프라인 입력: 멀티페이지 PDF" Margin="0,8,0,16" HorizontalAlignment="Center" Foreground="#607385" />
                        <Button Content="PDF 선택" Command="{Binding SelectFileCommand}" Width="140"
                                automation:AutomationProperties.Name="OCR 처리할 파일 선택" />
                        <TextBlock Text="{Binding SelectedFileName}" Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="#34536B" />
                        <TextBlock Text="{Binding FileStatus}" Margin="0,5,0,0" HorizontalAlignment="Center" Foreground="#607385" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Margin="0,28,0,24" Background="#F8FBFD" BorderBrush="#D7E0E8" BorderThickness="1" CornerRadius="5" Padding="18">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="읽기 방식" FontSize="17" FontWeight="SemiBold" Foreground="#18344A" />
                        <ComboBox Margin="0,16,0,12" Padding="8,5" SelectedValue="{Binding ReadingMode}" SelectedValuePath="Content"
                                  automation:AutomationProperties.Name="문서 읽기 방식">
                            <ComboBoxItem Content="정밀 변환" />
                            <ComboBoxItem Content="빠른 읽기" />
                        </ComboBox>
                        <TextBlock Text="정밀 변환은 표·도표·수식·악보 같은 특수 객체를 개별 분석합니다." TextWrapping="Wrap" Foreground="#607385" />
                    </StackPanel>
                </Border>

                <DockPanel Grid.Row="2" Grid.ColumnSpan="2">
                    <TextBlock Text="파일은 분석을 시작할 때까지 서버에 전송되지 않습니다." Foreground="#607385" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="가져오기 설정" Width="160"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="ImportSettings"
                            automation:AutomationProperties.Name="가져오기 설정으로 이동" />
                </DockPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="18" Margin="0,22,0,0" BorderBrush="#D7E0E8" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="최근 프로젝트" FontWeight="SemiBold" Foreground="#18344A" />
                <TextBlock Text="아직 최근 프로젝트가 없습니다. PDF를 선택해 새 분석을 시작하세요." Foreground="#52697A" Margin="0,5,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
