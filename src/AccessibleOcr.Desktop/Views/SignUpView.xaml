<UserControl x:Class="AccessibleOcr.Desktop.Views.SignUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid Background="#F4F7FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <Border Background="#123A59">
            <StackPanel Margin="70" VerticalAlignment="Center" MaxWidth="540">
                <TextBlock Foreground="White" FontSize="38" FontWeight="Bold" Text="계정 만들기" />
                <TextBlock Margin="0,18,0,0" Foreground="#D7E8F5" FontSize="19" LineHeight="30" TextWrapping="Wrap"
                           Text="리더와 자원봉사자는 계정을 신청할 수 있습니다. 기관 검수자 권한은 관리자가 별도로 부여합니다." />
                <Border Margin="0,34,0,0" Padding="18" Background="#173F5E" BorderBrush="#507590" BorderThickness="1" CornerRadius="7">
                    <TextBlock Foreground="#D7E8F5" TextWrapping="Wrap"
                               Text="현재는 회원가입 화면 골격 단계입니다. 입력 정보는 서버나 DB로 전송되지 않습니다." />
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" Background="White" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="390" Margin="40" VerticalAlignment="Center">
                <TextBlock FontSize="30" FontWeight="Bold" Foreground="#18344A" Text="회원가입" />
                <TextBlock Margin="0,8,0,24" Foreground="#607385" Text="필수 정보를 입력하세요." />

                <TextBlock FontWeight="SemiBold" Foreground="#18344A" Text="이름" />
                <TextBox Margin="0,7,0,14" Height="40" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         automation:AutomationProperties.Name="회원가입 이름" />

                <TextBlock FontWeight="SemiBold" Foreground="#18344A" Text="이메일" />
                <TextBox Margin="0,7,0,14" Height="40" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         automation:AutomationProperties.Name="회원가입 이메일" />

                <TextBlock FontWeight="SemiBold" Foreground="#18344A" Text="비밀번호" />
                <PasswordBox Margin="0,7,0,14" Height="40" Padding="10,7" PasswordChanged="PasswordBox_OnPasswordChanged"
                             automation:AutomationProperties.Name="회원가입 비밀번호" />

                <TextBlock FontWeight="SemiBold" Foreground="#18344A" Text="비밀번호 확인" />
                <PasswordBox Margin="0,7,0,14" Height="40" Padding="10,7" PasswordChanged="PasswordConfirmationBox_OnPasswordChanged"
                             automation:AutomationProperties.Name="회원가입 비밀번호 확인" />

                <TextBlock FontWeight="SemiBold" Foreground="#18344A" Text="계정 유형" />
                <ComboBox Margin="0,7,0,5" Height="42" Padding="8,5"
                          ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}"
                          DisplayMemberPath="DisplayName" automation:AutomationProperties.Name="회원가입 계정 유형" />
                <TextBlock Margin="0,0,0,18" Foreground="#607385" FontSize="12" TextWrapping="Wrap"
                           Text="{Binding SelectedRole.Description}" />

                <Button Height="44" Command="{Binding SubmitCommand}" Content="가입 정보 확인"
                        automation:AutomationProperties.Name="회원가입 입력 정보 확인" />
                <Button Height="42" Margin="0,4,0,0" Style="{StaticResource SecondaryButton}"
                        Command="{Binding BackToLoginCommand}" Content="로그인으로 돌아가기"
                        automation:AutomationProperties.Name="로그인 화면으로 돌아가기" />

                <Border Margin="0,15,0,20" Padding="13" Background="#FFF8E9" BorderBrush="#F0B544" BorderThickness="1" CornerRadius="5">
                    <TextBlock Foreground="#7A4800" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               automation:AutomationProperties.LiveSetting="Polite" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
