<Window x:Class="AccessibleOcr.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="접근형 OCR" Height="820" Width="1380" MinHeight="680" MinWidth="1060"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource NavyBrush}">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="접근형 OCR" Foreground="White" FontSize="23" FontWeight="Bold" />
                    <TextBlock Text="문서를 더 읽기 쉽게" Foreground="#C9DAE9" Margin="0,5,0,34" />

                    <Button Content="새 프로젝트" Command="{Binding NavigateCommand}" CommandParameter="Home"
                            automation:AutomationProperties.Name="새 프로젝트 화면으로 이동" />
                    <Button Content="최근 파일" Style="{StaticResource SecondaryButton}" Command="{Binding NavigateCommand}" CommandParameter="Home"
                            automation:AutomationProperties.Name="최근 파일 목록으로 이동" />
                    <Button Content="내보낸 파일" Style="{StaticResource SecondaryButton}" Command="{Binding NavigateCommand}" CommandParameter="Export"
                            automation:AutomationProperties.Name="검수와 내보내기 화면으로 이동" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="상태: 준비됨" Foreground="#C9DAE9" FontSize="12" />
                    <Button Content="설정" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"
                            Command="{Binding NavigateCommand}" CommandParameter="ImportSettings" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#D9E1E8" BorderThickness="0,0,0,1">
                <DockPanel Margin="28,0">
                    <TextBlock Text="구조 읽기 / 검수 / 내보내기" VerticalAlignment="Center" Foreground="#607385" />
                    <TextBlock Text="F1 도움말  |  Alt+1 개요  Alt+2 객체  Alt+3 검수" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#607385" FontSize="12" />
                </DockPanel>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="28" />
        </Grid>
    </Grid>
</Window>
